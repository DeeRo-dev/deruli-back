DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña
DB_DATABASE=nombre_db

# El esquema se cambia con migraciones (pnpm migration:run).
# Dejar en false salvo que estés prototipando una entidad nueva.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# TLS: false en local, true contra Supabase o cualquier Postgres remoto.
DB_SSL=false

# true hace que cada arranque aplique las migraciones pendientes.
# En local conviene false y correrlas a mano.
DB_MIGRATIONS_RUN=false

# Supabase Storage — imágenes (avatares, lugares, reseñas, mesas).
# La URL del proyecto, ej. https://abcdefgh.supabase.co
SUPABASE_URL=
# OJO: la service role key saltea las políticas RLS del bucket.
# Va SOLO en el backend. Nunca en el front, nunca en una variable VITE_*,
# nunca commiteada. Si se filtra, rotala desde el panel de Supabase.
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=tu_jwt_secret
JWT_EXPIRES_IN=7d
PORT=3000

# Orígenes permitidos por CORS, separados por coma.
# Debe incluir el puerto real donde corre el front (Vite salta a 5174 si 5173 está ocupado).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
